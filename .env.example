# ==========================================================
# HARDWARE - Store Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# NEVER commit .env to version control!
# ==========================================================

# Application Environment (production / development / testing)
APP_ENV=production
APP_URL=https://your-domain.netlify.app/
APP_KEY=your-32-char-random-encryption-key-here

# Database Connectivity (PostgreSQL / Netlify Database)
# Option 1: Direct PostgreSQL Connection URL (recommended for Netlify/Supabase/Neon)
DATABASE_URL=postgresql://username:password@ep-host.aws.neon.tech:5432/hardware?sslmode=require

# Option 2: Discrete PostgreSQL Parameters
DB_CONNECTION=pdo
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=hardware
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL_MODE=require
