# CodeIgniter gitignore
/vendor/
/system/

# Environment and sensitive configuration files
.env
.env.*
!.env.example

# Application cache and logs
/application/cache/*
!/application/cache/index.html
!/application/cache/.gitkeep
/application/logs/*
!/application/logs/index.html
!/application/logs/.gitkeep

# SQLite local test databases
*.sqlite
*.sqlite3
*.db

# Temporary test scripts
test_*.php

# User uploads (keep default assets)
/uploads/products/*
!/uploads/products/default.*
!/uploads/products/*.svg
!/uploads/products/.htaccess
!/uploads/products/index.html

# Operating System & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
